# Copy this file to .env.production on the server. Do not commit real secrets.

ALPHAPILOT_PUBLIC_HOST=your-domain.example
ALPHAPILOT_POSTGRES_PASSWORD=change-me-long-random-password
ALPHAPILOT_DATABASE_URL=postgresql+psycopg://alphapilot:change-me-long-random-password@postgres:5432/alphapilot
ALPHAPILOT_REDIS_URL=redis://redis:6379/0
ALPHAPILOT_QUEUE_BACKEND=redis
ALPHAPILOT_RATE_LIMIT_ENABLED=true
ALPHAPILOT_RATE_LIMIT=60
ALPHAPILOT_RATE_LIMIT_WINDOW_SECONDS=60

DEEPSEEK_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=false
